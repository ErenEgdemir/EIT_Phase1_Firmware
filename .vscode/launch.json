{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32F411",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/EIT_Phase1_Firmware.elf",
      "servertype": "openocd",
      "serverpath": "/opt/homebrew/bin/openocd",
      "device": "STM32F411CEUx",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f4x.cfg"
      ],
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      },
      "runToEntryPoint": "main",
      "gdbPath": "/opt/ST/STM32CubeCLT_1.21.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
      
    }
  ]
}